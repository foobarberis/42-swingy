<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ctrl-C shutdown intentionally terminates the process immediately without save. -->
    <Match>
        <Class name="com.swingy.app.Main"/>
        <Method name="~lambda.*"/>
        <Bug pattern="DM_EXIT"/>
    </Match>

    <!-- Controllers keep injected collaborators by design (application wiring layer). -->
    <Match>
        <Class name="com.swingy.controller.AppController"/>
        <Method name="&lt;init&gt;"/>
        <Field name="view"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.swingy.controller.AppController"/>
        <Method name="&lt;init&gt;"/>
        <Field name="gameController"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.swingy.controller.GameController"/>
        <Method name="&lt;init&gt;"/>
        <Field name="repository"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.swingy.controller.MenuController"/>
        <Method name="&lt;init&gt;"/>
        <Field name="repository"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
